// most of this was stolen from https://tailscale.com/docs/reference/examples/acls and written by claude...
{
  // tagOwners: which users can *assign* a tag to a device (not what the tag can access).
  "tagOwners": {
    "tag:trusted": ["autogroup:admin"],
    "tag:sandbox": ["autogroup:admin"],
  },

  "grants": [
    // Untagged devices (personal machines) — full access
    {"src": ["autogroup:member"], "dst": ["*"], "ip": ["*"]},
    // Trusted tagged devices — full access
    {"src": ["tag:trusted"],      "dst": ["*"], "ip": ["*"]},
    // allow outbound from sandbox to ollama IP
    {"src": ["tag:sandbox"], "dst": ["*"], "ip": ["tcp:11434"]},
    // sandbox devices can reach each other
    {"src": ["tag:sandbox"], "dst": ["tag:sandbox"], "ip": ["*"]},
    // outbound access from pi-box to joels-mac-mini on mautrix imessage port (defined in mautrix-imessage-registration)
    {"src": ["tag:sandbox"], "dst": ["*"], "ip": ["tcp:29320"]},
  ],

  // no "ssh" section: machines run openssh, keys in secrets/user-keys.nix
  "tests": [
    {
      "src": "tag:sandbox",
      "accept": ["tag:sandbox:22"],
      "deny": ["tag:trusted:22"],
    },
  ],
}
