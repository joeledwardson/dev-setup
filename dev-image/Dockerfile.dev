FROM archlinux:base
ENV HOME=/root
WORKDIR $HOME

# claude code
RUN pacman -Syu --noconfirm curl
RUN curl -sSL https://claude.ai/install.sh | bash

# packages (see ./modules/nixos-base.nix for my default headless packages)
# Refresh here too: a cached earlier layer can contain stale Arch package indexes.
RUN pacman -Syu --noconfirm \
openssh \
zsh \
fzf \
git \
eza \
man-db \
tmux \
jq \
fastfetch \
fd \
github-cli \
ripgrep \
vim \
neovim \
wget \
unzip \
net-tools \
file \
socat \
bat \
uv \
yazi \
git-delta \
zellij \
sheldon \
go-task \
glab \
gcc make \
nodejs npm \
python python-pip \
postgresql-libs && \
    pacman -Scc --noconfirm

ENV SHELL=/bin/zsh
ENV PATH="$HOME/.local/bin:$PATH"
ENV EDITOR=nvim

# Copy only the shell, terminal, and file-manager configs used in this image.
COPY configs/zshrc $HOME/.zshrc
COPY configs/sheldon/plugins.toml $HOME/.config/sheldon/plugins.toml
COPY configs/tmux/ $HOME/.config/tmux/
COPY configs/yazi/*.toml configs/yazi/*.lua $HOME/.config/yazi/

# Separate plugin list: do not copy the desktop init or its pack lockfile.
COPY dev-image/nvim/init.lua $HOME/.config/nvim/init.lua
COPY configs/nvim/lua/plugins/telescope.lua \
     configs/nvim/lua/plugins/ufo.lua \
     configs/nvim/lua/plugins/diffview.lua \
     configs/nvim/lua/plugins/oil.lua \
     configs/nvim/lua/plugins/whichkey.lua \
     configs/nvim/lua/plugins/mini.lua \
     $HOME/.config/nvim/lua/plugins/
COPY configs/nvim/lua/custom/keybrowser.lua $HOME/.config/nvim/lua/custom/keybrowser.lua
# vim.pack installs the selected plugins and generates a lockfile inside the image.
RUN nvim --headless '+lua if vim.v.errmsg ~= "" then vim.cmd.cquit() end' +qa

# Install TPM and the plugins declared in the tmux config.
RUN git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm" && \
    "$HOME/.tmux/plugins/tpm/bin/install_plugins"

# Install the pinned Yazi plugins and flavor.
RUN ya pkg install

# change default shell
RUN chsh root -s /bin/zsh

# load zsh plugins
RUN sheldon lock

# generate ssh key for container
RUN ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519 -N "" -q

# dont run initial prompt for login, see here: https://tessl.io/blog/configuring-claude-code/
COPY ./dev-image/claude.json $HOME/.claude.json

# claude yolo alias
COPY ./dev-image/zshrclocal $HOME/.config/zshrclocal
