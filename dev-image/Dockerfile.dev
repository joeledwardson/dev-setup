FROM archlinux:base
ENV HOME=/root
WORKDIR $HOME

# claude code
RUN pacman -Syu --noconfirm curl
RUN curl -sSL https://claude.ai/install.sh | bash

# Shell, navigation and Git tools used by the shared configs.
# Refresh here too: a cached earlier layer can contain stale Arch package indexes.
RUN pacman -Syu --needed --noconfirm \
    openssh zsh sheldon \
    eza fzf fd ripgrep bat less man-db \
    git git-delta lazygit \
    tmux python jq file && \
    pacman -Scc --noconfirm

# Match the desktop's Neovim release instead of following Arch's rolling package.
ARG NVIM_VERSION=0.12.5
ARG NVIM_SHA256=bce0f56eda1f1b1db6eee8f4133d7a38813ea07933837dd1777411ca384c6875
RUN curl -fL "https://github.com/neovim/neovim/releases/download/v${NVIM_VERSION}/nvim-linux-x86_64.tar.gz" -o /tmp/nvim.tar.gz && \
    echo "${NVIM_SHA256}  /tmp/nvim.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/nvim.tar.gz -C /opt && \
    ln -s /opt/nvim-linux-x86_64/bin/nvim /usr/local/bin/nvim && \
    rm /tmp/nvim.tar.gz

ENV SHELL=/bin/zsh
ENV PATH="$HOME/.local/bin:$PATH"
ENV EDITOR=nvim

# Copy only the shell, terminal, and file-manager configs used in this image.
COPY configs/zshrc $HOME/.zshrc
COPY configs/sheldon/plugins.toml $HOME/.config/sheldon/plugins.toml
COPY configs/tmux/ $HOME/.config/tmux/
COPY --chmod=755 configs/bin/tmux-switcher $HOME/.local/bin/tmux-switcher
COPY configs/yazi/*.toml configs/yazi/*.lua $HOME/.config/yazi/

# Shared core entry point; the desktop extras and lockfile stay outside the image.
COPY configs/nvim/init_core.lua $HOME/.config/nvim/init.lua
COPY configs/nvim/lua/core/ $HOME/.config/nvim/lua/core/
# vim.pack installs the selected plugins and generates a lockfile inside the image.
RUN nvim -l "$HOME/.config/nvim/init.lua"

# Install TPM and the plugins declared in the tmux config.
RUN git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm" && \
    "$HOME/.tmux/plugins/tpm/bin/install_plugins"

# Load zsh plugins
RUN sheldon lock

# generate ssh key for container
RUN ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519 -N "" -q

# dont run initial prompt for login, see here: https://tessl.io/blog/configuring-claude-code/
COPY ./dev-image/claude.json $HOME/.claude.json

# claude yolo alias
COPY ./dev-image/zshrclocal $HOME/.config/zshrclocal
