// Zed settings shared by desktop hosts.
// https://zed.dev/docs/configuring-zed
{
  "cli_default_open_behavior": "existing_window",
  "auto_install_extensions": {
    "terraform": true
  },
  "ssh_connections": [
    {
      "host": "worker207",
      "args": [],
      "projects": []
    }
  ],
  "use_system_path_prompts": false,
  "vim_mode": true,
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-5.6-sol",
        "reasoning_effort": "ultra",
        "mode": "agent-full-access"
      },
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "agent": {
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-6.2-sol",
      "enable_thinking": true,
      "effort": "medium"
    },
    "expand_terminal_card": false
  },
  "active_pane_modifiers": {
    "border_size": 3.0,
    "inactive_opacity": 0.75
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "theme_overrides": {
    "One Light": {
      "border.focused": "#005FCC",
      "panel.focused_border": "#005FCC",
      "pane.focused_border": "#005FCC"
    },
    "One Dark": {
      "border.focused": "#66CCFF",
      "panel.focused_border": "#66CCFF",
      "pane.focused_border": "#66CCFF"
    }
  }
}
