// Zed settings shared by desktop hosts.
// https://zed.dev/docs/configuring-zed
{
  "cli_default_open_behavior": "existing_window",
  "auto_install_extensions": {
    "terraform": true
  },
  "ssh_connections": [
    {
      "host": "worker207",
      "args": [],
      "projects": []
    }
  ],
  "use_system_path_prompts": false,
  "vim_mode": true,
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-5.6-sol",
        "reasoning_effort": "ultra",
        "mode": "agent-full-access"
      },
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "agent": {
    "sandbox_permissions": {
      "allow_all_hosts": true,
    },
    "tool_permissions": {
      "default": "confirm",
      "tools": {
        "fetch": {
          "default": "allow"
        },
        "terminal": {
          "default": "confirm",
          // patterns must start with ^ - chained commands only auto-run if every part matches
          "always_allow": [
            { "pattern": "^readlink(?:[ \\t]+-f)?(?:[ \\t]+[A-Za-z0-9_./][A-Za-z0-9_./-]*)+[ \\t]*\\z" },
            { "pattern": "^(?:tofu|terraform)(?:[ \\t]+-chdir=[A-Za-z0-9_./-]+)?[ \\t]+validate[ \\t]*\\z" },
            { "pattern": "^(?:tofu|terraform)[ \\t]+fmt(?:[ \\t]+-(?:recursive|diff))*[ \\t]+-check(?:[ \\t]+-(?:recursive|diff))*(?:[ \\t]+[A-Za-z0-9_./][A-Za-z0-9_./-]*\\.tf)?[ \\t]*\\z" },
            { "pattern": "^sed[ \\t]+-n[ \\t]+(?:'[0-9]+(?:,[0-9]+)?p'|\"[0-9]+(?:,[0-9]+)?p\"|[0-9]+(?:,[0-9]+)?p)(?:[ \\t]+[A-Za-z0-9_./][A-Za-z0-9_./-]*)+[ \\t]*\\z" },
            { "pattern": "^(find|ls|pwd|cat|head|tail|wc|file|stat|which|tree|du|df|rg|grep|fd)(\\s|$)" },
            { "pattern": "^git[ \\t]+(?:--no-pager[ \\t]+)?(?:--no-optional-locks[ \\t]+)?(?:status|log|diff|show|blame|rev-parse|ls-files)([ \\t]|$)", "case_sensitive": true },
            { "pattern": "^command[ \\t]+-v[ \\t]+[A-Za-z0-9_][A-Za-z0-9_.+-]*[ \\t]*\\z", "case_sensitive": true },
            { "pattern": "^gh\\s+(pr|issue|run|repo|release)\\s+(view|list|diff|checks|status)(\\s|$)" }
          ],
          "always_confirm": [
            { "pattern": "^rg\\b.*\\s--pre\\b" },
            { "pattern": "^git\\s+push\\b" },
            { "pattern": "^sudo\\b" }
          ]
        }
      }
    },
    "profiles": {
      "joels-yolo": {
        "name": "joels-yolo",
        "tools": {},
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-6.2-sol",
      "enable_thinking": true,
      "effort": "medium"
    },
    "expand_terminal_card": false
  },
  "active_pane_modifiers": {
    "border_size": 3.0,
    "inactive_opacity": 0.75
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "theme_overrides": {
    "One Light": {
      "border.focused": "#005FCC",
      "panel.focused_border": "#005FCC",
      "pane.focused_border": "#005FCC"
    },
    "One Dark": {
      "border.focused": "#66CCFF",
      "panel.focused_border": "#66CCFF",
      "pane.focused_border": "#66CCFF"
    }
  }
}
