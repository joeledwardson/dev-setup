{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "trajectory": {
      "command": [
        "trajectory",
        "mcp"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "plugin": [
    "~/.config/opencode/plugins/trajectory"
  ],
  "policies": [
    {
      "action": "provider.use",
      "effect": "deny",
      "resource": "*"
    },
    {
      "action": "provider.use",
      "effect": "allow",
      "resource": "ollama"
    },
    {
      "action": "provider.use",
      "effect": "allow",
      "resource": "openrouter"
    },
    {
      "action": "provider.use",
      "effect": "allow",
      "resource": "opencode-go"
    },
    {
      "action": "provider.use",
      "effect": "allow",
      "resource": "ollama-cloud"
    }
  ]
}
