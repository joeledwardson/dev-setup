[remmina]
encodings=
username=claude
name=streaming server
disableencryption=0
ssh_tunnel_privatekey=
password=
quality=2
disablesmoothscrolling=0
precommand=
ssh_tunnel_enabled=0
labels=
ssh_tunnel_command=
keyboard_grab=0
viewonly=0
ignore-tls-errors=1
aspect_ratio=
postcommand=
closeonfailure=0
server=streaming-server
ssh_tunnel_command_args=
tightencoding=0
disablepasswordstoring=0
scale=1
ssh_tunnel_username=
disconnect-prompt=0
disableclipboard=0
disableserverbell=0
ssh_tunnel_password=
profile-lock=0
disableserverinput=0
ssh_tunnel_server=
colordepth=32
ssh_tunnel_loopback=0
ssh_tunnel_auth=0
vnc_timeout=0
notes_text=
window_maximize=1
enable-autostart=0
ssh_tunnel_certfile=
keymap=
viewmode=1
proxy=
protocol=VNC
ssh_tunnel_passphrase=
showcursor=0
group=personal
