#!/usr/bin/env bash
# Run one prompt through OpenCode and print findings for RunWisp to catch.
set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "usage: $0 <job-name> [--force]" >&2
  exit 64
fi

job=$1
force=${2:-}
prompt_path="$ROOT/jobs/$job.prompt.md"
schema_path="$ROOT/findings.schema.json"

[[ -f $prompt_path ]] || { echo "no such job: $job" >&2; exit 64; }
[[ -r $schema_path ]] || { echo "missing schema: $schema_path" >&2; exit 66; }

OPENCODE_BIN=${OPENCODE_BIN:-opencode}
MODEL=${AGENT_ALERTS_MODEL:-ollama-cloud/deepseek-v4.1-flash}
OLLAMA_KEY_FILE=${AGENT_ALERTS_OLLAMA_KEY_FILE:-/run/agenix/ollama-api-key}

[[ -r $OLLAMA_KEY_FILE ]] || { echo "ollama API key not readable: $OLLAMA_KEY_FILE" >&2; exit 69; }

prompt=$(cat "$prompt_path")

# A forced test prepends an override so the agent always creates a finding.
if [[ $force == --force ]]; then
  prompt=$'ALWAYS NOTIFY — this is a test.\n\n'"$prompt"
fi

# OpenCode has no --output-schema, so put the contract in the prompt and
# validate the final message below before treating it as structured output.
full_prompt="$prompt"$'\n\nReturn only JSON matching this JSON Schema:\n\n'"$(cat "$schema_path")"

raw=$(mktemp)
errors=$(mktemp)
trap 'rm -f "$raw" "$errors"' EXIT

if ! OLLAMA_API_KEY="$(cat "$OLLAMA_KEY_FILE")" \
  "$OPENCODE_BIN" run \
  --standalone \
  --model "$MODEL" \
  --format json \
  --auto \
  "$full_prompt" >"$raw" 2>"$errors"; then
  echo "opencode run failed:" >&2
  tail -n 50 "$errors" >&2
  exit 1
fi

# The final text event is the agent's response; reject anything that is not
# the agreed object before looking for notices.
result=$(jq -sr '[.[] | select(.type == "text") | .part.text] | last // empty' "$raw")
if ! jq -e 'type == "object" and (.notices | type == "array")' <<<"$result" >/dev/null 2>&1; then
  echo "agent returned invalid structured output:" >&2
  printf '%s\n' "$result" >&2
  exit 1
fi

notices=$(jq -c '.notices' <<<"$result")
[[ $notices == '[]' ]] && { echo "NO FINDINGS"; exit 0; }

mkdir -p "$ROOT/notified"
has_errors=0

while read -r notice; do
  [[ -z $notice ]] && continue
  kind=$(jq -r '.kind' <<<"$notice")
  id=$(jq -r '.id' <<<"$notice")

  if [[ $kind == error ]]; then
    summary=$(jq -r '.summary' <<<"$notice")
    echo "AGENT_REPORTED_ERROR: $id — $summary" >&2
    has_errors=1
    continue
  fi

  # Hash IDs because they are usually URLs, which contain slashes.
  fingerprint=$(printf '%s' "$id" | sha256sum | cut -d' ' -f1)

  # Skip duplicates unless forced.
  if [[ $force != --force && -f "$ROOT/notified/$fingerprint" ]]; then
    echo "DUPLICATE: $id"
    continue
  fi

  touch "$ROOT/notified/$fingerprint"
  title=$(jq -r '.title' <<<"$notice")
  summary=$(jq -r '.summary' <<<"$notice")
  echo "NEW_FINDING: $title"
  echo "  $summary"

  # When forced, also publish directly to ntfy to prove the full pipeline.
  if [[ $force == --force ]]; then
    ntfy_token=$(cat "${AGENT_ALERTS_NTFY_TOKEN_FILE:-/run/agenix/ntfy-token}" 2>/dev/null || true)
    if [[ -n $ntfy_token ]]; then
      curl -fsS -m 10 \
        -H "Authorization: Bearer $ntfy_token" \
        -H "Title: $job: $title" \
        -H "Priority: default" \
        -H "Tags: agent-alert,test" \
        -d "$summary" \
        "https://ntfy.sh/jollof-alerts" >/dev/null 2>&1 && \
        echo "  → ntfy sent" || echo "  → ntfy failed" >&2
    fi
  fi
done < <(jq -c '.[]' <<<"$notices")

exit "$has_errors"
